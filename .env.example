# Copy to .env and adjust as needed: cp .env.example .env
# Values validated at startup by app/src/config/config.module.ts.
# Defaults below assume the backing services from ../docker-compose.dev.yml.

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=kudo-service
PORT=3000
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://goodjob:goodjob@localhost:5432/goodjob
DB_POOL_SIZE=10

# ── Messaging (Redis Streams event bus) ──────────────────────────────────
MQ_URL=redis://localhost:6379
MQ_STREAM=kudo:events

# ── Point ─────────────────────────────────────────────────────────────────
# Monthly giving budget granted to each sender (provisioned at registration,
# reset by BudgetResetWorker on the 1st of each month).
GIVING_BUDGET=200

# ── Storage (MinIO / S3-compatible) ──────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=goodjob-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin

# ── Realtime ──────────────────────────────────────────────────────────────
# REALTIME_PROVIDER=redis requires REALTIME_REDIS_URL to be set.
REALTIME_PROVIDER=redis
REALTIME_REDIS_URL=redis://localhost:6379

# ── Security (auth tokens) ────────────────────────────────────────────────
AUTH_ACCESS_TOKEN_SECRET=7d90b0e25fc629227a1ba44dd54d24835b7f6f64abe33518b614af6a3aa07ed
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_SECRET=304cf612415eea7b740fff6f7ab5acb795d642666e621c6a0cb5f1976f5d13a
AUTH_REFRESH_TOKEN_TTL=7d
